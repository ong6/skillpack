#!/usr/bin/env python3
"""Link, sync, guard, publish, tidy and search the public and private agent-skill checkouts.

  skills up       --repo R --machines M [--hook claude|codex] [--wait]
  skills link     --repo R --machines M
  skills unlink   --repo R --machines M
  skills doctor   --repo R --machines M [--json]
  skills autosync --repo R --machines M
  skills publish  --checkout C -m MESSAGE
  skills guard    [PATH ...] [--root DIR] [--terms FILE]
  skills find     [QUERY ...] [--json] [--limit N]
  skills usage    --repo R --machines M [--scan] [--json]
  skills tidy     --repo R --machines M [--dry-run]
  skills shelve | restore NAME ... [--repo R --machines M]

The profile comes from the machines registry (--machines): the first machine whose `match`
fields all equal this host's facts (os, model, hostname prefix, wsl, user) supplies its
`skills` object. No match means project scope, the --repo only, public skills only.
Checkouts live at <root>/skills and <root>/skills-private; links point at
<checkout>/skills/<name>. Only symlinks into those two checkouts are ever changed.

Each checkout has two tiers. `skills/<name>` is the core set that gets linked.
`rarely-used/<name>` holds skills nobody has used for 30 days: never linked, still found by
`find` and readable in place. Once a day the background sync records which skills this machine's
Claude Code and Codex sessions used (`usage/<machine>.json` in the private checkout). It then
moves idle core skills to the shelf and shelved skills that were used again back to core, and
pushes the result. Pinned skills (catalog `pinned:`) and skills a core skill names stay in core.

Stdlib only, Python 3.7+. This tool never starts a model session: the only AI CLI it runs is
`claude mcp get|add`, to register MCP servers.

Environment: SKILLS_FACTS (JSON merged into the detected host facts, to simulate another
machine), SKILLS_NO_FETCH=1, SKILLS_FETCH_INTERVAL (seconds, default 300),
SKILLS_MAINTAIN_INTERVAL (seconds between usage scans and tidies, default 86400), SKILLS_TODAY
(YYYY-MM-DD, tests), SKILLS_ROOT (guard), SKILLS_PUBLIC_URL, SKILLS_PRIVATE_URL, HOST_REPO
(lint fallback), CLAUDE_CONFIG_DIR and CODEX_HOME (where transcripts live).
"""
from __future__ import annotations

import argparse
import ast
import contextlib
import datetime
import fnmatch
import glob
import getpass
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import time

try:
    import fcntl
except ImportError:  # pragma: no cover - not POSIX
    fcntl = None

PUBLIC = "skills"
PRIVATE = "skills-private"
DEFAULT_ROOT = "~/Sideproject"  # public-guard: allow
PUBLIC_URL = "https://github.com/ong6/skills.git"
PRIVATE_URLS = ("https://github.com/ong6/skills-private.git", "git@github.com:ong6/skills-private.git")
LINK_SUBDIRS = (".claude/skills", ".agents/skills")
CORE = "skills"
SHELF = "rarely-used"
TIERS = (CORE, SHELF)
FETCH_INTERVAL = 300
MAINTAIN_INTERVAL = 86400
IDLE_DAYS = 30
USAGE_DAYS = 90
USAGE_DIR = "usage"
EXCLUDE_START = "# >>> skills links (managed by bin/skills)"
EXCLUDE_END = "# <<< skills links"
UNMATCHED = "unregistered machine"


# ---------------------------------------------------------------------------------------- basics

def home():
    return os.path.expanduser("~")


def expand(path):
    return os.path.abspath(os.path.expanduser(path))


def short(path):
    h = home().rstrip(os.sep) + os.sep
    return "~/" + path[len(h):] if path.startswith(h) else path


def cache_dir():
    return os.path.join(home(), ".cache", "skills")


def stamp(name):
    return os.path.join(cache_dir(), name)


def mtime(path):
    try:
        return os.path.getmtime(path)
    except OSError:
        return None


def touch(path):
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "a"):
            pass
        os.utime(path, None)
    except OSError:
        pass


def ago(when):
    if when is None:
        return "never"
    s = max(0, int(time.time() - when))
    if s < 60:
        return "just now"
    for unit, size in (("d", 86400), ("h", 3600), ("m", 60)):
        if s >= size:
            return "{}{} ago".format(s // size, unit)
    return "just now"


def today():
    raw = os.environ.get("SKILLS_TODAY")
    if raw:
        try:
            return datetime.datetime.strptime(raw, "%Y-%m-%d").date()
        except ValueError:
            pass
    return datetime.date.today()


def days_before(day, n):
    return (day - datetime.timedelta(days=n)).isoformat()


def interval(name, default):
    try:
        return float(os.environ.get(name, default))
    except ValueError:
        return default


def slug(text):
    return re.sub(r"[^a-z0-9]+", "-", str(text).lower()).strip("-") or "machine"


def quiet_env():
    """Environment that can never prompt: no terminal, askpass or ssh passphrase prompts."""
    env = dict(os.environ)
    ssh = env.get("GIT_SSH_COMMAND") or "ssh"
    env.update({
        "GIT_TERMINAL_PROMPT": "0",
        "GCM_INTERACTIVE": "never",
        "GIT_ASKPASS": "true",
        "SSH_ASKPASS_REQUIRE": "never",
        "GIT_SSH_COMMAND": ssh + " -o BatchMode=yes -o ConnectTimeout=10",
    })
    return env


def run(cmd, cwd=None, timeout=30):
    try:
        return subprocess.run(cmd, cwd=cwd, env=quiet_env(), stdin=subprocess.DEVNULL,
                              stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                              universal_newlines=True, timeout=timeout)
    except (OSError, ValueError, subprocess.SubprocessError):
        return None


def git(checkout, *args, **kw):
    return run(["git", "-C", checkout] + list(args), timeout=kw.get("timeout", 30))


def git_out(checkout, *args, **kw):
    r = git(checkout, *args, **kw)
    return r.stdout.strip() if r is not None and r.returncode == 0 else None


@contextlib.contextmanager
def file_lock(path, blocking=True, timeout=10.0):
    """flock-based lock; yields True when held. Never raises for lock trouble."""
    fh = None
    got = False
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        fh = open(path, "a")
    except OSError:
        fh = None
    if fh is None or fcntl is None:
        got = True
    else:
        deadline = time.time() + timeout
        while True:
            try:
                fcntl.flock(fh.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
                got = True
                break
            except OSError:
                if not blocking or time.time() >= deadline:
                    break
                time.sleep(0.1)
    try:
        yield got
    finally:
        if fh is not None:
            if got and fcntl is not None:
                try:
                    fcntl.flock(fh.fileno(), fcntl.LOCK_UN)
                except OSError:
                    pass
            fh.close()


def checkout_lock_path(checkout):
    gitdir = os.path.join(checkout, ".git")
    if os.path.isdir(gitdir):
        return os.path.join(gitdir, "skills.lock")
    digest = hashlib.sha1(os.path.realpath(checkout).encode("utf-8")).hexdigest()[:16]
    return os.path.join(cache_dir(), "locks", digest + ".lock")


def say(line, stream=None):
    stream = stream or sys.stdout
    try:
        stream.write(line + "\n")
    except UnicodeEncodeError:
        stream.write(line.encode("ascii", "replace").decode("ascii") + "\n")


# -------------------------------------------------------------------------------------- profiles

def host_facts():
    import platform
    facts = {}
    override = {}
    raw = os.environ.get("SKILLS_FACTS")
    if raw:
        try:
            value = json.loads(raw)
            override = value if isinstance(value, dict) else {}
        except ValueError:
            override = {}
    facts["os"] = platform.system()
    facts["hostname"] = platform.node().split(".")[0]
    try:
        facts["user"] = getpass.getuser()
    except Exception:  # noqa: BLE001 - no passwd entry and no USER
        facts["user"] = ""
    if facts["os"] == "Darwin" and "model" not in override:
        r = run(["sysctl", "-n", "hw.model"], timeout=2)
        facts["model"] = r.stdout.strip() if r is not None and r.returncode == 0 else ""
    try:
        with open("/proc/version", encoding="utf-8") as fh:
            facts["wsl"] = "microsoft" in fh.read().lower()
    except OSError:
        facts["wsl"] = False
    facts.update(override)
    return facts


def rule_matches(rule, facts):
    """Every field equal, hostname by prefix."""
    for key, want in rule.items():
        if key == "hostname":
            if not str(facts.get("hostname", "")).startswith(str(want)):
                return False
        elif facts.get(key) != want:
            return False
    return True


def default_profile():
    return {"scope": "project", "root": DEFAULT_ROOT, "private": False, "repos": [],
            "enable": ["*"], "disable": [], "mcp": []}


def str_list(value, fallback):
    if isinstance(value, str):
        return [value]
    if isinstance(value, list):
        return [v for v in value if isinstance(v, str) and v.strip()]
    return list(fallback)


def load_profile(machines, facts):
    """(machine name or None, profile, has_skills_object) for the first matching machine."""
    profile = default_profile()
    if not machines:
        return None, profile, False
    try:
        with open(expand(machines), encoding="utf-8") as fh:
            registry = json.load(fh)
    except (OSError, ValueError, TypeError):
        return None, profile, False
    entries = registry.get("machines") if isinstance(registry, dict) else None
    for entry in entries if isinstance(entries, list) else []:
        rule = entry.get("match", {}) if isinstance(entry, dict) else None
        if not isinstance(rule, dict) or not rule_matches(rule, facts):
            continue
        raw = entry.get("skills")
        if not isinstance(raw, dict):
            return str(entry.get("name") or "matched machine"), profile, False
        if raw.get("scope") in ("project", "user"):
            profile["scope"] = raw["scope"]
        if isinstance(raw.get("root"), str) and raw["root"].strip():
            profile["root"] = raw["root"]
        profile["private"] = raw.get("private") is True
        for key in ("repos", "enable", "disable", "mcp"):
            if key in raw:
                profile[key] = str_list(raw[key], profile[key])
        return str(entry.get("name") or "matched machine"), profile, True
    return None, profile, False


def dedupe_paths(paths):
    seen, out = set(), []
    for p in paths:
        key = os.path.realpath(p)
        if key not in seen:
            seen.add(key)
            out.append(p)
    return out


class Context(object):
    def __init__(self, args):
        self.facts = host_facts()
        self.machine, self.profile, self.has_profile = load_profile(
            getattr(args, "machines", None), self.facts)
        self.scope = self.profile["scope"]
        self.root = expand(self.profile["root"])
        self.public = os.path.join(self.root, PUBLIC)
        self.private = os.path.join(self.root, PRIVATE)
        self.use_private = self.profile["private"]
        repos = [expand(r) for r in (getattr(args, "repo", None) or [])]
        repos += [expand(r) for r in self.profile["repos"]]
        self.repos = dedupe_paths(repos)
        self.live_repos = [r for r in self.repos if os.path.isdir(r)]
        self.home_dirs = [os.path.join(home(), d) for d in LINK_SUBDIRS]
        self.repo_dirs = [os.path.join(r, d) for r in self.live_repos for d in LINK_SUBDIRS]
        # A repo at $HOME would make a project link dir equal a home dir; never guard it away.
        repo_real = set(os.path.realpath(d) for d in self.repo_dirs)
        self.guard_home_dirs = [d for d in self.home_dirs if os.path.realpath(d) not in repo_real]

    @property
    def where(self):
        return "{}, {}".format(self.machine or UNMATCHED, self.scope)

    def checkouts(self):
        return [self.public] + ([self.private] if self.use_private else [])


# --------------------------------------------------------------------------------------- catalog

def strip_comment(text):
    """Drop a trailing ` # comment` that sits outside quotes."""
    quote = None
    i = 0
    while i < len(text):
        ch = text[i]
        if quote:
            if ch == "\\" and quote == '"':
                i += 1
            elif ch == quote:
                quote = None
        elif ch in "'\"" and (i == 0 or text[i - 1] in " \t[,:-"):
            quote = ch
        elif ch == "#" and (i == 0 or text[i - 1] in " \t"):
            return text[:i].rstrip()
        i += 1
    return text.rstrip()


def split_flow(inner):
    parts, quote, start = [], None, 0
    for i, ch in enumerate(inner):
        if quote:
            if ch == quote:
                quote = None
        elif ch in "'\"":
            quote = ch
        elif ch == ",":
            parts.append(inner[start:i])
            start = i + 1
    parts.append(inner[start:])
    return [p for p in parts if p.strip()]


def scalar(value):
    v = value.strip()
    if v.startswith("[") and v.endswith("]"):
        return [scalar(x) for x in split_flow(v[1:-1])]
    if v == "{}":
        return {}
    if len(v) >= 2 and v[0] == v[-1] == '"':
        try:
            return json.loads(v)
        except ValueError:
            return v[1:-1]
    if len(v) >= 2 and v[0] == v[-1] == "'":
        return v[1:-1].replace("''", "'")
    if v in ("true", "false"):
        return v == "true"
    return v


YAML_KEY = re.compile(r"^([^\s:'\"\[\]{}#-][^:]*?|-[^\s:][^:]*?)\s*:(?:\s+(.*))?$")


def yaml_item(text):
    return text == "-" or text.startswith("- ")


def yaml_block(lines, i, indent):
    if yaml_item(lines[i][1]):
        return yaml_seq(lines, i, indent)
    return yaml_map(lines, i, indent)


def yaml_seq(lines, i, indent):
    out = []
    while i < len(lines) and lines[i][0] == indent and yaml_item(lines[i][1]):
        rest = lines[i][1][1:]
        item = rest.lstrip()
        if not item:
            i += 1
            if i < len(lines) and lines[i][0] > indent:
                value, i = yaml_block(lines, i, lines[i][0])
                out.append(value)
            else:
                out.append(None)
        elif YAML_KEY.match(item) and item[0] not in "'\"[":
            child = indent + 1 + len(rest) - len(item)
            lines[i] = (child, item)
            value, i = yaml_map(lines, i, child)
            out.append(value)
        else:
            out.append(scalar(item))
            i += 1
    return out, i


def yaml_map(lines, i, indent):
    out = {}
    while i < len(lines) and lines[i][0] == indent and not yaml_item(lines[i][1]):
        m = YAML_KEY.match(lines[i][1])
        if not m:
            raise ValueError("line {!r} is not `key: value`".format(lines[i][1]))
        key, rest = m.group(1).strip(), (m.group(2) or "").strip()
        i += 1
        if rest:
            out[key] = scalar(rest)
        elif i < len(lines) and (lines[i][0] > indent or (lines[i][0] == indent and yaml_item(lines[i][1]))):
            out[key], i = yaml_block(lines, i, lines[i][0])
        else:
            out[key] = None
    return out, i


def load_yaml(text):
    """The YAML subset catalog.yaml uses: block mappings and lists, flow lists of scalars, quoted
    or plain scalars, comments. No PyYAML needed. Raises ValueError on anything else."""
    lines = []
    for raw in text.splitlines():
        if not raw.strip() or raw.lstrip().startswith("#"):
            continue
        if "\t" in raw[:len(raw) - len(raw.lstrip())]:
            raise ValueError("tab indentation")
        body = strip_comment(raw.strip())
        if body:
            lines.append((len(raw) - len(raw.lstrip(" ")), body))
    if not lines:
        return {}
    value, i = yaml_block(lines, 0, lines[0][0])
    if i != len(lines):
        raise ValueError("unexpected indentation at {!r}".format(lines[i][1]))
    return value


def read_catalog(checkout):
    """catalog.yaml as a dict ({} when missing or unreadable)."""
    try:
        with open(os.path.join(checkout, "catalog.yaml"), encoding="utf-8") as fh:
            data = load_yaml(fh.read())
        return data if isinstance(data, dict) else {}
    except (OSError, UnicodeError, ValueError):
        return {}


def catalog_categories(catalog):
    """{category key: set(skill names)}."""
    cats = {}
    for c in catalog.get("categories") or []:
        if isinstance(c, dict) and isinstance(c.get("key"), str):
            names = c.get("skills") if isinstance(c.get("skills"), list) else []
            cats.setdefault(c["key"], set()).update(n for n in names if isinstance(n, str) and n)
    return cats


def parse_catalog(path):
    return catalog_categories(read_catalog(os.path.dirname(path)))


# ------------------------------------------------------------------------------------------ plan

def scan(checkout, tier=CORE):
    """{name: folder} for every skill folder (one holding a SKILL.md) in a checkout tier."""
    base = os.path.join(checkout, tier)
    found = {}
    try:
        names = sorted(os.listdir(base))
    except OSError:
        return found
    for name in names:
        path = os.path.join(base, name)
        if not name.startswith(".") and os.path.isfile(os.path.join(path, "SKILL.md")):
            found[name] = path
    return found


class Plan(object):
    def __init__(self, ctx):
        public = scan(ctx.public)
        private = scan(ctx.private) if ctx.use_private else {}
        self.categories = {}
        for checkout in ctx.checkouts():
            for key, names in parse_catalog(os.path.join(checkout, "catalog.yaml")).items():
                self.categories.setdefault(key, set()).update(names)
        self.available = dict(public)
        self.available.update(private)
        self.overrides = sorted(set(public) & set(private))
        enable, disable = ctx.profile["enable"], ctx.profile["disable"]
        self.selected = {}
        for name in sorted(self.available):
            if any(self.hit(s, name) for s in enable) and not any(self.hit(s, name) for s in disable):
                self.selected[name] = self.available[name]
        self.unknown = []
        for s in enable + disable:
            if s.startswith("category:"):
                if s[len("category:"):] not in self.categories:
                    self.unknown.append(s)
            elif not any(fnmatch.fnmatchcase(n, s) for n in self.available):
                self.unknown.append(s)

    def hit(self, selector, name):
        if selector.startswith("category:"):
            return name in self.categories.get(selector[len("category:"):], ())
        return fnmatch.fnmatchcase(name, selector)


# ----------------------------------------------------------------------------------------- links

def link_target(path):
    try:
        t = os.readlink(path)
    except OSError:
        return None
    if not os.path.isabs(t):
        t = os.path.join(os.path.dirname(path), t)
    return os.path.normpath(t)


def canon(path):
    """Resolve the parents but not the last component, which may dangle."""
    return os.path.join(os.path.realpath(os.path.dirname(path)), os.path.basename(path))


class Owner(object):
    """Recognises symlinks that point into our two checkouts (and nothing else)."""

    def __init__(self, checkouts):
        self.prefixes = set()
        for c in checkouts:
            for v in (os.path.normpath(c), os.path.realpath(c)):
                self.prefixes.add(v.rstrip(os.sep) + os.sep)

    def owns(self, link):
        t = link_target(link)
        if t is None:
            return False
        for cand in (t, canon(t)):
            for p in self.prefixes:
                if (cand + os.sep).startswith(p):
                    return True
        return False


def same_target(link, target):
    t = link_target(link)
    return t is not None and (t == os.path.normpath(target) or canon(t) == canon(target))


class LinkResult(object):
    def __init__(self):
        self.added, self.replaced, self.removed = [], [], []
        self.conflicts, self.unwritable = [], []
        self.linked = {}  # link dir -> names linked there

    @property
    def changed(self):
        return bool(self.added or self.replaced or self.removed)


def sync_dir(d, desired, owner, result, create=True, quiet=False):
    """Make our links in d equal desired; never touch anything we don't own."""
    if desired and create and not os.path.isdir(d):
        try:
            os.makedirs(d)
        except OSError:
            result.unwritable.append(d)
            return
    if not os.path.isdir(d):
        return
    try:
        names = sorted(os.listdir(d))
    except OSError:
        return
    ours = [n for n in names if os.path.islink(os.path.join(d, n)) and owner.owns(os.path.join(d, n))]
    pending = [n for n in ours if n not in desired]
    pending += [n for n in desired if not (os.path.islink(os.path.join(d, n))
                                           and same_target(os.path.join(d, n), desired[n]))]
    if pending and not os.access(d, os.W_OK):
        if not quiet:
            result.unwritable.append(d)
        return
    linked = result.linked.setdefault(d, [])
    for name in ours:
        if name in desired:
            continue
        try:
            os.unlink(os.path.join(d, name))
            result.removed.append(os.path.join(d, name))
        except OSError:
            pass
    for name, target in sorted(desired.items()):
        path = os.path.join(d, name)
        if os.path.islink(path):
            if same_target(path, target):
                linked.append(name)
                continue
            if not owner.owns(path):
                result.conflicts.append(path)
                continue
            tmp = path + ".skills-tmp"
            try:
                if os.path.lexists(tmp):
                    os.unlink(tmp)
                os.symlink(target, tmp)
                os.replace(tmp, path)
                result.replaced.append(path)
                linked.append(name)
            except OSError:
                result.conflicts.append(path)
        elif os.path.lexists(path):
            result.conflicts.append(path)
        else:
            try:
                os.symlink(target, path)
                result.added.append(path)
                linked.append(name)
            except OSError:
                if os.path.islink(path) and same_target(path, target):
                    linked.append(name)
                else:
                    result.conflicts.append(path)


def write_exclude(repo, entries):
    """Keep linked paths out of the repo's git status via .git/info/exclude."""
    gitdir = os.path.join(repo, ".git")
    if not os.path.isdir(gitdir):
        return
    path = os.path.join(gitdir, "info", "exclude")
    try:
        with open(path, encoding="utf-8") as fh:
            text = fh.read()
    except (OSError, UnicodeError):
        text = ""
    kept, inside = [], False
    for line in text.splitlines():
        if line == EXCLUDE_START:
            inside = True
        elif line == EXCLUDE_END:
            inside = False
        elif not inside:
            kept.append(line)
    if entries:
        kept += [EXCLUDE_START] + sorted(entries) + [EXCLUDE_END]
    new = "\n".join(kept).rstrip("\n") + "\n" if kept else ""
    if new.rstrip("\n") == text.rstrip("\n"):
        return
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "w", encoding="utf-8") as fh:
            fh.write(new)
    except OSError:
        pass


def do_link(ctx, plan=None):
    plan = plan or Plan(ctx)
    owner = Owner([ctx.public, ctx.private])
    result = LinkResult()
    with file_lock(stamp("link.lock"), timeout=5):
        if ctx.scope == "project":
            for d in ctx.repo_dirs:
                sync_dir(d, plan.selected, owner, result)
            for d in ctx.guard_home_dirs:  # scope guard
                sync_dir(d, {}, owner, result, create=False, quiet=True)
            for repo in ctx.live_repos:
                entries = []
                for sub in LINK_SUBDIRS:
                    for name in result.linked.get(os.path.join(repo, sub), []):
                        entries.append("/{}/{}".format(sub, name))
                write_exclude(repo, entries)
        else:
            for d in ctx.home_dirs:
                sync_dir(d, plan.selected, owner, result)
            for d in ctx.repo_dirs:
                if d not in ctx.home_dirs:
                    sync_dir(d, {}, owner, result, create=False, quiet=True)
            for repo in ctx.live_repos:
                write_exclude(repo, [])
    return plan, result


def do_unlink(ctx):
    owner = Owner([ctx.public, ctx.private])
    result = LinkResult()
    with file_lock(stamp("link.lock"), timeout=5):
        for d in dedupe_paths(ctx.repo_dirs + ctx.home_dirs):
            sync_dir(d, {}, owner, result, create=False, quiet=d in ctx.home_dirs)
        for repo in ctx.live_repos:
            write_exclude(repo, [])
    return result


# ------------------------------------------------------------------------------------------- mcp

def claude_config():
    base = os.environ.get("CLAUDE_CONFIG_DIR")
    path = os.path.join(base, ".claude.json") if base else os.path.join(home(), ".claude.json")
    try:
        with open(path, encoding="utf-8") as fh:
            data = json.load(fh)
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}


def mcp_in_files(repo, name, config):
    """Cheap check before asking `claude mcp get`: local, user and .mcp.json scopes."""
    projects = config.get("projects") if isinstance(config.get("projects"), dict) else {}
    for key in (repo, os.path.realpath(repo)):
        servers = (projects.get(key) or {}).get("mcpServers") if isinstance(projects.get(key), dict) else None
        if isinstance(servers, dict) and name in servers:
            return True
    user = config.get("mcpServers")
    if isinstance(user, dict) and name in user:
        return True
    try:
        with open(os.path.join(repo, ".mcp.json"), encoding="utf-8") as fh:
            shared = json.load(fh).get("mcpServers", {})
        return isinstance(shared, dict) and name in shared
    except (OSError, ValueError, AttributeError):
        return False


def load_servers(ctx):
    try:
        with open(os.path.join(ctx.private, "mcp", "servers.json"), encoding="utf-8") as fh:
            data = json.load(fh)
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return None


class McpResult(object):
    def __init__(self):
        self.added, self.failed, self.undefined, self.missing = [], [], [], []
        self.no_claude = False


def mcp_command(claude, name, spec, repo):
    def sub(value):
        return str(value).replace("{store}", repo)
    cmd = [claude, "mcp", "add", "-s", "local", name]
    env = spec.get("env") if isinstance(spec.get("env"), dict) else {}
    for key in sorted(env):
        cmd += ["-e", "{}={}".format(key, sub(env[key]))]
    args = spec.get("args") if isinstance(spec.get("args"), list) else []
    return cmd + ["--", sub(spec["command"])] + [sub(a) for a in args]


def register_mcp(ctx, apply=True):
    """Register each profile MCP server at Claude local scope for every repo, once."""
    result = McpResult()
    names = ctx.profile["mcp"]
    if not names or not ctx.live_repos:
        return result
    servers = load_servers(ctx)
    if servers is None:
        result.undefined = list(names)
        return result
    config = claude_config()
    claude = shutil.which("claude")
    for repo in ctx.live_repos:
        for name in names:
            spec = servers.get(name)
            if not isinstance(spec, dict) or not isinstance(spec.get("command"), str):
                if name not in result.undefined:
                    result.undefined.append(name)
                continue
            if mcp_in_files(repo, name, config):
                continue
            if not claude:
                result.no_claude = True
                result.missing.append((repo, name))
                continue
            got = run([claude, "mcp", "get", name], cwd=repo, timeout=20)
            if got is not None and got.returncode == 0:
                continue
            if not apply:
                result.missing.append((repo, name))
                continue
            added = run(mcp_command(claude, name, spec, repo), cwd=repo, timeout=60)
            if added is not None and added.returncode == 0:
                result.added.append(name)
            else:
                result.failed.append(name)
    return result


# ------------------------------------------------------------------------------------------ sync

def clone(url, dest, timeout=600):
    part = "{}.partial-{}".format(dest, os.getpid())
    shutil.rmtree(part, ignore_errors=True)
    r = run(["git", "clone", "--quiet", url, part], timeout=timeout)
    if r is None or r.returncode != 0:
        shutil.rmtree(part, ignore_errors=True)
        return False, "clone failed: " + ((r.stderr.strip().splitlines() or ["timeout"])[-1] if r else "timeout")
    try:
        os.rename(part, dest)
    except OSError as error:
        shutil.rmtree(part, ignore_errors=True)
        return False, "clone failed: {}".format(error)
    return True, None


def last_line(r, fallback="?"):
    if r is None:
        return "timeout"
    return ((r.stderr or r.stdout or "").strip().splitlines() or [fallback])[-1]


def ahead_behind(checkout):
    counts = git_out(checkout, "rev-list", "--left-right", "--count", "HEAD...@{u}")
    try:
        ahead, behind = counts.split()
        return int(ahead), int(behind)
    except (AttributeError, ValueError):
        return 0, 0


def push_checkout(checkout):
    """Push local commits; the public checkout's are guarded first. (ok, error)"""
    if not is_private_checkout(checkout):
        hits, _, _, _ = run_guard(sorted(os.path.join(checkout, p) for p in changed_paths(checkout, True)
                                         if os.path.isfile(os.path.join(checkout, p))),
                                  root=os.path.dirname(checkout))
        if hits:
            return False, "unpushed commits fail the guard ({}); not pushed".format(
                ", ".join(sorted(set("{}:{}".format(os.path.relpath(h[0], checkout), h[1]) for h in hits))[:3]))
    r = git(checkout, "push", "--quiet", timeout=180)
    if r is None or r.returncode != 0:
        return False, "push failed: " + last_line(r)
    return True, None


def rebase_onto_upstream(checkout):
    """Replay local commits on the fetched upstream; on conflict abort and say so."""
    r = git(checkout, "rebase", "--quiet", "@{u}", timeout=120)
    if r is not None and r.returncode == 0:
        return None
    conflicted = git_out(checkout, "diff", "--name-only", "--diff-filter=U") or ""
    git(checkout, "rebase", "--abort")
    files = ", ".join(conflicted.split()) or "unknown files"
    return "diverged from origin and the rebase conflicts ({}); resolve by hand".format(files)


TIDY_SUBJECT = re.compile(r"^(?:Shelve|Restore) .*\((?:unused \d+\+ days|used again)\)$")


def only_tidy_commits(checkout):
    subjects = git_out(checkout, "log", "--format=%s", "@{u}..HEAD")
    return bool(subjects) and all(TIDY_SUBJECT.match(line) for line in subjects.splitlines())


def sync_one(checkout):
    """The pull flow: fetch; fast-forward, or rebase local commits, when the tree is clean; push
    commits an auto-sync, tidy or usage scan left behind. A dirty tree is left for the Stop
    hook's `autosync`, which commits first. (moved, error)"""
    with file_lock(checkout_lock_path(checkout), blocking=False) as got:
        if not got:
            return False, None
        r = git(checkout, "fetch", "--quiet", "--prune", "origin", timeout=120)
        if r is None or r.returncode != 0:
            return False, "fetch failed: " + last_line(r)
        if git_out(checkout, "rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{u}") is None:
            return False, None
        status = git_out(checkout, "status", "--porcelain")
        if status is None or status:
            return False, None
        ahead, behind = ahead_behind(checkout)
        moved = False
        if behind:
            if ahead:
                err = rebase_onto_upstream(checkout)
                if err and only_tidy_commits(checkout):
                    # Two machines tidied at once. Drop ours; the next daily tidy recomputes.
                    git(checkout, "reset", "--quiet", "--hard", "@{u}")
                    return True, None
                if err:
                    return False, err
            else:
                merged = git(checkout, "merge", "--ff-only", "--quiet", "@{u}")
                if merged is None or merged.returncode != 0:
                    return False, "fast-forward failed: " + last_line(merged)
            moved = True
        if ahead_behind(checkout)[0]:
            ok, err = push_checkout(checkout)
            if not ok:
                return moved, err
        return moved, None


def private_url():
    if os.environ.get("SKILLS_PRIVATE_URL"):
        return os.environ["SKILLS_PRIVATE_URL"]
    for url in PRIVATE_URLS:
        r = run(["git", "ls-remote", "--heads", url], timeout=20)
        if r is not None and r.returncode == 0:
            return url
    return None


def sync_checkouts(ctx, relink=True, maintain=True):
    """Clone missing checkouts, run the pull flow on the rest, and once a day record usage and
    tidy. Network; run in background."""
    with file_lock(stamp("sync.lock"), blocking=False) as got:
        if not got:
            return False
        touch(stamp("attempted"))
        changed, errors = False, []
        if os.path.isdir(ctx.public):
            moved, err = sync_one(ctx.public)
        else:
            moved, err = clone(os.environ.get("SKILLS_PUBLIC_URL") or PUBLIC_URL, ctx.public)
        changed = changed or moved
        public_ok = err is None or not err.startswith(("fetch", "clone"))
        if err:
            errors.append("public: " + err)
        if ctx.use_private:
            if os.path.isdir(ctx.private):
                moved, err = sync_one(ctx.private)
            else:
                url = private_url()
                moved, err = clone(url, ctx.private) if url else (False, "no non-interactive access")
            changed = changed or moved
            if err:
                errors.append("private: " + err)
        if public_ok:
            touch(stamp("fetched"))
        if maintain and maintain_due():
            touch(stamp("maintained"))
            notes, committed = maintain_checkouts(ctx)
            errors.extend(notes)
            for checkout in committed:
                changed = True
                _, err = sync_one(checkout)
                if err:
                    errors.append("{}: {}".format("private" if checkout == ctx.private else "public", err))
        for e in errors:
            say("skills sync: " + e, sys.stderr)
        if not errors:  # a clean run clears an older failure so doctor doesn't keep reporting it
            try:
                open(stamp("sync.log"), "w").close()
            except OSError:
                pass
        if changed and relink:
            do_link(ctx)
            register_mcp(ctx)
        return changed


def spawn_sync(ctx, args):
    if os.environ.get("SKILLS_NO_FETCH"):
        return
    last = mtime(stamp("attempted"))
    if last is not None and time.time() - last < interval("SKILLS_FETCH_INTERVAL", FETCH_INTERVAL):
        return
    touch(stamp("attempted"))
    cmd = [sys.executable, os.path.abspath(__file__), "_sync"]
    if getattr(args, "machines", None):
        cmd += ["--machines", expand(args.machines)]
    for repo in getattr(args, "repo", None) or []:
        cmd += ["--repo", expand(repo)]
    try:
        os.makedirs(cache_dir(), exist_ok=True)
        with open(stamp("sync.log"), "w") as log:
            subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=log, stderr=log, env=quiet_env(),
                             cwd=home(), close_fds=True, start_new_session=True)
    except OSError:
        pass


# ----------------------------------------------------------------------------------------- usage
#
# A use is a Skill tool call, a /slash command (Claude) or $mention (Codex) by the owner, or a tool
# call that reads or runs a file inside the skill folder (Claude: a Read, or a Bash command running
# its scripts/; Codex: any non-patch tool call naming SKILL.md, scripts/, references/ ...).
# Edits and searches are not uses, and a session (with its subagents) that touches more than
# MAINT_CAP skills' files is maintenance (audits, evals, lint passes), not use.

NOT_USE_TOOLS = {"Edit", "Write", "MultiEdit", "NotebookEdit", "apply_patch", "Grep", "Glob"}
SKILL_PATH = re.compile(r"(?=(?:skills|rarely-used)/([a-z0-9][a-z0-9-]*)/"
                        r"(?:SKILL\.md|scripts/|references/|assets/|templates/|examples/))")
SKILL_SCRIPT = re.compile(r"(?=(?:skills|rarely-used)/([a-z0-9][a-z0-9-]*)/scripts/)")
COMMAND = re.compile(r"<command-name>/?([a-z0-9:-]+)</command-name>")
DOLLAR = re.compile(r"(?<![\w$])\$([a-z][a-z0-9-]+)\b")
EVAL_MARKERS = ("skill-evals", "skill-audit", ".evals")
MAINT_CAP = 5


def line_day(obj, fallback):
    ts = obj.get("timestamp") if isinstance(obj, dict) else None
    return ts[:10] if isinstance(ts, str) and len(ts) >= 10 else fallback


def file_day(path):
    when = mtime(path)
    return datetime.date.fromtimestamp(when).isoformat() if when else today().isoformat()


def note(found, name, day, known):
    name = (name or "").split(":")[-1]
    if name in known:
        found[name] = max(found.get(name, ""), day)


def scan_claude(path, known):
    """(explicit {skill: day}, touched {skill: day}) from one Claude Code transcript."""
    explicit, touched = {}, {}
    fallback = file_day(path)
    try:
        fh = open(path, encoding="utf-8", errors="replace")
    except OSError:
        return explicit, touched
    with fh:
        for line in fh:
            if "skills/" not in line and "rarely-used/" not in line and "command-name" not in line \
                    and '"Skill"' not in line:
                continue
            try:
                obj = json.loads(line)
            except ValueError:
                continue
            if not isinstance(obj, dict):
                continue
            day = line_day(obj, fallback)
            message = obj.get("message") if isinstance(obj.get("message"), dict) else {}
            content = message.get("content")
            if obj.get("type") == "user":
                texts = [content] if isinstance(content, str) else [
                    c.get("text", "") for c in content or [] if isinstance(c, dict) and c.get("type") == "text"]
                for text in texts:
                    for name in COMMAND.findall(text or ""):
                        note(explicit, name, day, known)
            elif obj.get("type") == "assistant" and isinstance(content, list):
                for c in content:
                    if not isinstance(c, dict) or c.get("type") != "tool_use":
                        continue
                    inp = c.get("input") if isinstance(c.get("input"), dict) else {}
                    tool = c.get("name")
                    if tool == "Skill":
                        note(explicit, inp.get("skill"), day, known)
                    elif tool == "Read" or tool == "Bash":
                        # A Read of a skill file, or a command that runs a skill's script. Other
                        # Bash text (heredocs, greps, test fixtures) only mentions skills.
                        text = str(inp.get("file_path") or "") if tool == "Read" else str(inp.get("command") or "")
                        pattern = SKILL_PATH if tool == "Read" else SKILL_SCRIPT
                        for name in set(pattern.findall(text)):
                            note(touched, name, day, known)
    return explicit, touched


def scan_codex(path, known):
    """(explicit, touched) from one Codex rollout."""
    explicit, touched = {}, {}
    fallback = file_day(path)
    try:
        fh = open(path, encoding="utf-8", errors="replace")
    except OSError:
        return explicit, touched
    with fh:
        for line in fh:
            if '"response_item"' not in line:
                continue
            try:
                obj = json.loads(line)
            except ValueError:
                continue
            p = obj.get("payload") if isinstance(obj, dict) and isinstance(obj.get("payload"), dict) else {}
            day = line_day(obj, fallback)
            if p.get("type") == "message" and p.get("role") == "user":
                for c in p.get("content") or []:
                    text = c.get("text", "") if isinstance(c, dict) else ""
                    if text.startswith("# AGENTS.md") or "<environment_context>" in text:
                        continue
                    for name in DOLLAR.findall(text):
                        note(explicit, name, day, known)
            elif p.get("type") in ("function_call", "custom_tool_call") and p.get("name") not in NOT_USE_TOOLS:
                blob = json.dumps(p.get("arguments") or p.get("input") or "")
                for name in set(SKILL_PATH.findall(blob)):
                    note(touched, name, day, known)
    return explicit, touched


def under(path, roots):
    path = os.path.realpath(path)
    return any((path + os.sep).startswith(os.path.realpath(r).rstrip(os.sep) + os.sep) for r in roots)


def claude_transcripts(ctx, since):
    """Groups of transcript files, one per session (its main file plus its subagents' files),
    for sessions where any file changed since `since`."""
    base = os.path.join(os.environ.get("CLAUDE_CONFIG_DIR") or os.path.join(home(), ".claude"), "projects")
    prefixes = []
    for repo in ctx.repos:
        for form in set((repo, os.path.realpath(repo))):
            prefixes.append(re.sub(r"[^A-Za-z0-9]", "-", form))
    try:
        dirs = sorted(os.listdir(base))
    except OSError:
        return
    for d in dirs:
        if any(m in d for m in EVAL_MARKERS):
            continue
        if ctx.scope == "project" and not any(d == p or d.startswith(p + "-") for p in prefixes):
            continue
        sessions = {}
        for f in glob.glob(os.path.join(base, d, "**", "*.jsonl"), recursive=True):
            rel = os.path.relpath(f, os.path.join(base, d)).split(os.sep)
            key = rel[0][:-len(".jsonl")] if len(rel) == 1 else rel[0]
            sessions.setdefault(key, []).append(f)
        for key in sorted(sessions):
            files = sorted(sessions[key])
            if any((mtime(f) or 0) >= since for f in files):
                yield files


def codex_transcripts(ctx, since):
    base = os.path.join(os.environ.get("CODEX_HOME") or os.path.join(home(), ".codex"), "sessions")
    for f in glob.glob(os.path.join(base, "**", "*.jsonl"), recursive=True):
        if (mtime(f) or 0) < since:
            continue
        try:
            with open(f, encoding="utf-8", errors="replace") as fh:
                meta = json.loads(fh.readline())
            cwd = (meta.get("payload") or {}).get("cwd") or ""
        except (OSError, ValueError, AttributeError):
            continue
        if any(m in cwd for m in EVAL_MARKERS):
            continue
        if ctx.scope == "project" and not (cwd and under(cwd, ctx.repos)):
            continue
        yield [f]


def known_skills(ctx):
    names = set()
    for checkout in (ctx.public, ctx.private):
        for tier in TIERS:
            names.update(scan(checkout, tier))
    return names


def scan_usage(ctx, since):
    """{skill: set(days)} plus the oldest transcript day, for sessions changed since `since`."""
    known = known_skills(ctx)
    found, oldest = {}, None
    for groups, scanner in ((claude_transcripts(ctx, since), scan_claude),
                            (codex_transcripts(ctx, since), scan_codex)):
        for files in groups:
            explicit, touched = {}, {}
            for f in files:
                e, t = scanner(f, known)
                for src, dst in ((e, explicit), (t, touched)):
                    for name, day in src.items():
                        dst[name] = max(dst.get(name, ""), day)
                born = getattr(os.stat(f), "st_birthtime", None) if os.path.exists(f) else None
                day = datetime.date.fromtimestamp(born).isoformat() if born else file_day(f)
                oldest = day if oldest is None or day < oldest else oldest
            if len(touched) > MAINT_CAP:  # an audit, eval or lint pass across skills, not a use
                touched = {}
            for name, day in list(touched.items()) + list(explicit.items()):
                found.setdefault(name, set()).add(day)
    return found, oldest


def usage_path(ctx):
    return os.path.join(ctx.private, USAGE_DIR, slug(ctx.machine or ctx.facts.get("hostname") or "machine") + ".json")


def read_json(path):
    try:
        with open(path, encoding="utf-8") as fh:
            data = json.load(fh)
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}


def record_usage(ctx):
    """Scan transcripts changed since the last scan into this machine's usage file.
    Returns True when the file changed. Needs the private checkout."""
    if not (ctx.use_private and os.path.isdir(ctx.private)):
        return False
    path = usage_path(ctx)
    data = read_json(path)
    state = read_json(stamp("usage-scan.json"))
    first = not os.path.exists(path) or state.get("file") != path
    floor = time.time() - USAGE_DAYS * 86400
    since = floor if first else max(floor, float(state.get("scanned", 0)) - 3600)
    started = time.time()
    found, oldest = scan_usage(ctx, since)
    keep_from = days_before(today(), USAGE_DAYS)
    skills = {}
    old = data.get("skills") if isinstance(data.get("skills"), dict) else {}
    for name, days in list(old.items()) + [(n, sorted(d)) for n, d in found.items()]:
        if isinstance(days, list):
            skills.setdefault(name, set()).update(d for d in days if isinstance(d, str) and d >= keep_from)
    tracked = data.get("tracked_since") if isinstance(data.get("tracked_since"), str) else None
    if first and oldest:
        tracked = min(tracked or oldest, oldest)
    tracked = tracked or today().isoformat()
    new = {"machine": ctx.machine or UNMATCHED, "tracked_since": tracked,
           "skills": {n: sorted(d) for n, d in sorted(skills.items()) if d}}
    try:
        os.makedirs(os.path.dirname(stamp("x")), exist_ok=True)
        with open(stamp("usage-scan.json"), "w", encoding="utf-8") as fh:
            json.dump({"file": path, "scanned": started}, fh)
    except OSError:
        pass
    if new == data:
        return False
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w", encoding="utf-8") as fh:
        json.dump(new, fh, indent=1, sort_keys=True)
        fh.write("\n")
    return True


def merged_usage(ctx):
    """{"skills": {name: sorted days}, "tracked_since": oldest day or None, "machines": [...]}."""
    skills, tracked, machines = {}, None, []
    base = os.path.join(ctx.private, USAGE_DIR)
    for f in sorted(glob.glob(os.path.join(base, "*.json"))):
        data = read_json(f)
        days = data.get("skills") if isinstance(data.get("skills"), dict) else {}
        for name, ds in days.items():
            if isinstance(ds, list):
                skills.setdefault(name, set()).update(d for d in ds if isinstance(d, str))
        since = data.get("tracked_since")
        if isinstance(since, str):
            tracked = since if tracked is None or since < tracked else tracked
        machines.append(str(data.get("machine") or os.path.basename(f)[:-5]))
    return {"skills": {n: sorted(d) for n, d in skills.items()}, "tracked_since": tracked, "machines": machines}


# ------------------------------------------------------------------------------------------ tidy

TICKED_NAME = re.compile(r"`([a-z0-9][a-z0-9-]*)`")
PATH_NAME = re.compile(r"(?=(?:skills|rarely-used|\.\.)/([a-z0-9][a-z0-9-]*)/)")
DEP_SUFFIXES = (".md", ".py", ".sh", ".json", ".yaml", ".yml", ".txt", ".js", ".mjs", ".ts")


def skill_refs(folder, names):
    """Other skills a skill names (`name` in its text, or a path into a sibling skill)."""
    refs = set()
    for dp, dns, fns in os.walk(folder):
        dns[:] = [d for d in dns if d not in GUARD_SKIP_DIRS]
        for f in fns:
            if not f.endswith(DEP_SUFFIXES):
                continue
            try:
                with open(os.path.join(dp, f), encoding="utf-8") as fh:
                    text = fh.read(MAX_GUARD_BYTES)
            except (OSError, UnicodeError):
                continue
            if f.endswith(".md"):
                refs.update(TICKED_NAME.findall(text))
            refs.update(PATH_NAME.findall(text))
    return (refs & names) - {os.path.basename(folder)}


def tier_since(checkout, tier, name):
    """Day the skill last arrived at <tier>/<name> (created, restored or shelved). A skill that
    arrived in core within the window stays there, so new and restored skills get a month."""
    day = git_out(checkout, "log", "-1", "--no-renames", "--diff-filter=A", "--date=short", "--format=%cd",
                  "--", "{}/{}/SKILL.md".format(tier, name))
    return day or today().isoformat()


class Tidy(object):
    """Which core skills to shelve and which shelved skills to restore. Usage is per name, so a
    private skill that overrides a public one moves with it."""

    def __init__(self, ctx, usage=None):
        self.usage = usage if usage is not None else merged_usage(ctx)
        self.cutoff = days_before(today(), IDLE_DAYS)
        self.entries = {}  # (checkout, name) -> (tier, folder)
        self.pinned = set()
        for checkout in [c for c in ctx.checkouts() if os.path.isdir(c)]:
            pins = read_catalog(checkout).get("pinned")
            if isinstance(pins, list):
                self.pinned.update(p for p in pins if isinstance(p, str))
            for tier in TIERS:
                for name, folder in scan(checkout, tier).items():
                    self.entries[(checkout, name)] = (tier, folder)
        names = set(n for _, n in self.entries)
        self.refs = {}
        for (checkout, name), (tier, folder) in self.entries.items():
            self.refs.setdefault(name, set()).update(skill_refs(folder, names))
        self.last = {n: (self.usage["skills"].get(n) or [""])[-1] for n in names}
        self.since = {}
        for (checkout, name), (tier, _) in self.entries.items():
            self.since[name] = max(self.since.get(name, ""), tier_since(checkout, tier, name))
        tracked = self.usage.get("tracked_since")
        self.enough_data = bool(tracked) and tracked <= self.cutoff
        core = set(n for (_, n), (tier, _) in self.entries.items() if tier == CORE)
        shelf = set(n for (_, n), (tier, _) in self.entries.items() if tier == SHELF)
        self.reason = {}
        stay = set()
        for n in sorted(core):
            if n in self.pinned:
                self.reason[n] = "pinned"
            elif self.last[n] > self.cutoff:
                self.reason[n] = "used " + self.last[n]
            elif self.since[n] > self.cutoff:
                self.reason[n] = "new or restored " + self.since[n]
            elif not self.enough_data:
                self.reason[n] = "under {} days of usage data".format(IDLE_DAYS)
            else:
                continue
            stay.add(n)
        # Symmetric with shelving: a shelved skill used anywhere in the window comes back, even when
        # that use predates the shelving (another machine's usage can arrive late).
        restore = set(n for n in shelf if self.last[n] > self.cutoff)
        for n in restore:
            self.reason[n] = "used " + self.last[n]
        stay |= restore
        frontier = sorted(stay)
        while frontier:
            n = frontier.pop()
            for d in sorted(self.refs.get(n, ())):
                if d not in stay:
                    stay.add(d)
                    frontier.append(d)
                    self.reason[d] = "named by " + n
        self.restore = stay & shelf
        self.shelve = core - stay
        for n in self.shelve:
            self.reason[n] = "last used " + self.last[n] if self.last[n] else "no recorded use"

    def tier(self, name):
        tiers = set(t for (_, n), (t, _) in self.entries.items() if n == name)
        return CORE if CORE in tiers else SHELF

    def moves(self, checkout):
        here = lambda n, t: self.entries.get((checkout, n), (None,))[0] == t  # noqa: E731
        return ([n for n in sorted(self.shelve) if here(n, CORE)],
                [n for n in sorted(self.restore) if here(n, SHELF)])


def catalog_builder(checkout):
    script = os.path.join(checkout, "scripts", "build-catalog.py")
    return script if os.path.isfile(script) else None


def move_skills(checkout, shelve, restore, message=None):
    """Move skill folders between tiers in one clean checkout and commit. (ok, error)."""
    if not shelve and not restore:
        return True, None
    with file_lock(checkout_lock_path(checkout), blocking=True, timeout=60) as got:
        if not got:
            return False, "checkout is locked"
        if git_out(checkout, "status", "--porcelain"):
            return False, "checkout has uncommitted changes; tidy waits"
        if not message and ahead_behind(checkout) != (0, 0):
            return False, "checkout is not in step with origin; tidy waits for the next sync"
        builder = catalog_builder(checkout)
        if builder:
            probe = run([sys.executable, "-c", "import yaml"], timeout=20)
            if probe is None or probe.returncode != 0:
                return False, "PyYAML missing, so the README can't be rebuilt; tidy skipped"
        done = []
        for names, src, dst in ((shelve, CORE, SHELF), (restore, SHELF, CORE)):
            for name in names:
                a, b = os.path.join(checkout, src, name), os.path.join(checkout, dst, name)
                if os.path.lexists(b) or not os.path.isdir(a):
                    continue
                os.makedirs(os.path.dirname(b), exist_ok=True)
                os.rename(a, b)
                done.append((a, b))
        if not done:
            return True, None

        def undo(why):
            for a, b in reversed(done):
                if os.path.isdir(b) and not os.path.lexists(a):
                    os.rename(b, a)
            git(checkout, "reset", "--quiet", "--hard", "HEAD")
            return False, why

        if builder:
            r = run([sys.executable, builder], timeout=120)
            if r is None or r.returncode != 0:
                return undo("catalog rebuild failed: " + last_line(r))
        r = git(checkout, "add", "-A", timeout=60)
        if r is None or r.returncode != 0:
            return undo("git add failed: " + last_line(r))
        if not message:
            parts = []
            if shelve:
                parts.append("shelve {} (unused {}+ days)".format(", ".join(shelve), IDLE_DAYS))
            if restore:
                parts.append("restore {} (used again)".format(", ".join(restore)))
            message = "; ".join(parts)
            message = message[0].upper() + message[1:]
        r = git(checkout, "commit", "--quiet", "-m", message, timeout=120)
        if r is None or r.returncode != 0:
            return undo("git commit failed: " + last_line(r))
        return True, None


def maintain_due():
    last = mtime(stamp("maintained"))
    return last is None or time.time() - last >= interval("SKILLS_MAINTAIN_INTERVAL", MAINTAIN_INTERVAL)


def commit_usage(ctx):
    path = usage_path(ctx)
    rel = os.path.relpath(path, ctx.private)
    with file_lock(checkout_lock_path(ctx.private), blocking=True, timeout=60) as got:
        if not got:
            return False
        git(ctx.private, "add", "--", rel)
        r = git(ctx.private, "commit", "--quiet", "-m", "Record skill usage on " + (ctx.machine or UNMATCHED),
                "--", rel, timeout=60)
        return r is not None and r.returncode == 0


def maintain_checkouts(ctx):
    """Daily: record usage, then tidy both checkouts. (notes, checkouts with new commits)."""
    notes, committed = [], []
    if not (ctx.use_private and os.path.isdir(ctx.private)):
        return notes, committed  # usage lives in the private checkout; no data, no tidy
    try:
        if record_usage(ctx) and commit_usage(ctx):
            committed.append(ctx.private)
        tidy = Tidy(ctx)
        for checkout in ctx.checkouts():
            shelve, restore = tidy.moves(checkout)
            before = git_out(checkout, "rev-parse", "HEAD")
            ok, err = move_skills(checkout, shelve, restore)
            if err:
                notes.append("tidy {}: {}".format(os.path.basename(checkout), err))
            if ok and git_out(checkout, "rev-parse", "HEAD") != before and checkout not in committed:
                committed.append(checkout)
    except Exception as error:  # noqa: BLE001 - background maintenance must never crash the sync
        notes.append("maintain failed ({}: {})".format(type(error).__name__, error))
    return notes, committed


# -------------------------------------------------------------------------------- up / link / ...

def status_line(ctx, plan, result, mcp):
    parts = ["skills: {} linked ({})".format(len(plan.selected), ctx.where)]
    fetched = mtime(stamp("fetched"))
    parts.append("fetched " + ago(fetched) if fetched else "never fetched")
    if result.changed:
        added = set(os.path.basename(p) for p in result.added + result.replaced)
        removed = set(os.path.basename(p) for p in result.removed) - added
        parts.append("{} added, {} removed".format(len(added), len(removed)))
    if plan.overrides:
        parts.append("private overrides public: " + ", ".join(plan.overrides))
    if result.conflicts:
        parts.append("{} conflict(s), run skills doctor".format(len(result.conflicts)))
    if result.unwritable:
        parts.append("not writable: " + ", ".join(short(d) for d in result.unwritable))
    if not os.path.isdir(ctx.public):
        parts.append("public checkout missing" + ("" if os.environ.get("SKILLS_NO_FETCH")
                                                  else " (cloning in background)"))
    if ctx.use_private and not os.path.isdir(ctx.private):
        parts.append("private checkout missing")
    if mcp.added:
        parts.append("mcp added: " + ", ".join(sorted(set(mcp.added))))
    if mcp.failed:
        parts.append("mcp failed: " + ", ".join(sorted(set(mcp.failed))))
    return " · ".join(parts)


def cmd_up(args):
    changed = False
    try:
        ctx = Context(args)
        if args.wait:
            sync_checkouts(ctx, relink=False, maintain=False)
        else:
            spawn_sync(ctx, args)
        plan, result = do_link(ctx)
        changed = result.changed
        mcp = register_mcp(ctx)
        line = status_line(ctx, plan, result, mcp)
    except Exception as error:  # noqa: BLE001 - a session start must never fail
        line = "skills: up failed ({}: {})".format(type(error).__name__, error)
    try:
        if args.hook == "claude" and changed:
            say(json.dumps({"hookSpecificOutput": {
                "hookEventName": "SessionStart", "additionalContext": line, "reloadSkills": True}}))
        else:
            say(line)
    except Exception:  # noqa: BLE001
        pass
    return 0


def cmd_link(args):
    ctx = Context(args)
    plan, result = do_link(ctx)
    for path in result.added + result.replaced:
        say("linked   " + short(path))
    for path in result.removed:
        say("removed  " + short(path))
    for path in result.conflicts:
        say("conflict " + short(path) + " (not ours; left alone)", sys.stderr)
    for name in plan.overrides:
        say("note: private {} overrides public {}".format(name, name))
    say(status_line(ctx, plan, result, McpResult()))
    return 1 if result.conflicts or result.unwritable else 0


def cmd_unlink(args):
    ctx = Context(args)
    result = do_unlink(ctx)
    for path in result.removed:
        say("removed  " + short(path))
    say("skills: {} link(s) removed".format(len(result.removed)))
    return 1 if result.unwritable else 0


def checkout_state(path):
    state = {"path": path, "exists": os.path.isdir(path)}
    if not state["exists"]:
        return state
    state["branch"] = git_out(path, "rev-parse", "--abbrev-ref", "HEAD")
    status = git_out(path, "status", "--porcelain")
    state["dirty"] = len(status.splitlines()) if status else 0
    counts = git_out(path, "rev-list", "--left-right", "--count", "HEAD...@{u}")
    if counts:
        ahead, behind = counts.split()
        state["ahead"], state["behind"] = int(ahead), int(behind)
    return state


def cmd_doctor(args):
    ctx = Context(args)
    plan = Plan(ctx)
    owner = Owner([ctx.public, ctx.private])
    problems, warnings = [], []
    report = {
        "machine": ctx.machine or UNMATCHED,
        "facts": {k: ctx.facts.get(k) for k in ("os", "model", "hostname", "user", "wsl")},
        "profile": ctx.profile, "has_profile": ctx.has_profile, "root": ctx.root,
        "scope": ctx.scope, "repos": ctx.repos, "selected": sorted(plan.selected),
        "overrides": plan.overrides, "checkouts": {}, "links": {},
    }
    for label, path, needed in (("public", ctx.public, True), ("private", ctx.private, ctx.use_private)):
        state = checkout_state(path) if needed or os.path.isdir(path) else {"path": path, "exists": False}
        report["checkouts"][label] = state
        if not state["exists"]:
            if needed:
                problems.append("{} checkout missing: {}".format(label, short(path)))
            continue
        if state.get("dirty"):
            problems.append("{} checkout dirty: {} file(s); `skills autosync` (the Stop hook) or "
                            "`skills publish` commits it".format(label, state["dirty"]))
        state["rarely_used"] = sorted(scan(path, SHELF))
        if state.get("ahead"):
            warnings.append("{} checkout has {} unpushed commit(s)".format(label, state["ahead"]))
        if state.get("behind"):
            warnings.append("{} checkout is {} commit(s) behind its upstream".format(label, state["behind"]))
    for repo in ctx.repos:
        if repo not in ctx.live_repos:
            warnings.append("repo not found: " + short(repo))
    active = ctx.repo_dirs if ctx.scope == "project" else ctx.home_dirs
    guarded = ctx.guard_home_dirs if ctx.scope == "project" else [d for d in ctx.repo_dirs if d not in ctx.home_dirs]
    for d in active:
        entry = {"ok": 0, "missing": [], "conflicts": [], "stale": [], "dangling": []}
        report["links"][d] = entry
        for name, target in sorted(plan.selected.items()):
            path = os.path.join(d, name)
            if os.path.islink(path) and same_target(path, target):
                entry["ok"] += 1
            elif os.path.lexists(path) and not (os.path.islink(path) and owner.owns(path)):
                entry["conflicts"].append(name)
            else:
                entry["missing"].append(name)
        for name in sorted(os.listdir(d)) if os.path.isdir(d) else []:
            path = os.path.join(d, name)
            if not os.path.islink(path):
                continue
            if not os.path.exists(path):
                if owner.owns(path):
                    entry["dangling"].append(name)
                else:
                    warnings.append("foreign dangling link (left alone): " + short(path))
            elif owner.owns(path) and name not in plan.selected:
                entry["stale"].append(name)
        if entry["missing"]:
            problems.append("{}: {} missing link(s): {}".format(short(d), len(entry["missing"]),
                                                                  ", ".join(entry["missing"])))
        if entry["conflicts"]:
            problems.append("{}: not ours, so not linked: {}".format(short(d), ", ".join(entry["conflicts"])))
        if entry["dangling"]:
            problems.append("{}: dangling link(s): {}".format(short(d), ", ".join(entry["dangling"])))
        if entry["stale"]:
            problems.append("{}: stale link(s): {}".format(short(d), ", ".join(entry["stale"])))
        if (entry["missing"] or entry["stale"] or entry["dangling"]) and os.path.isdir(d) \
                and not os.access(d, os.W_OK):
            problems.append("{} is not writable".format(short(d)))
    for d in guarded:
        if not os.path.isdir(d):
            continue
        leaked = [n for n in sorted(os.listdir(d))
                  if os.path.islink(os.path.join(d, n)) and owner.owns(os.path.join(d, n))]
        if leaked:
            problems.append("{} scope, but {} holds our links: {}".format(ctx.scope, short(d), ", ".join(leaked)))
    for selector in plan.unknown:
        warnings.append("enable/disable entry matches nothing: " + selector)
    mcp = register_mcp(ctx, apply=False)
    for name in mcp.undefined:
        warnings.append("mcp {} is not defined in {}".format(name, short(os.path.join(ctx.private, "mcp", "servers.json"))))
    for repo, name in mcp.missing:
        (warnings if mcp.no_claude else problems).append("mcp {} not registered for {}".format(name, short(repo)))
    fetched, attempted = mtime(stamp("fetched")), mtime(stamp("attempted"))
    report["fetched"], report["attempted"] = fetched, attempted
    report["maintained"] = mtime(stamp("maintained"))
    if ctx.use_private and os.path.isdir(ctx.private):
        usage = merged_usage(ctx)
        report["usage"] = {"machines": usage["machines"], "tracked_since": usage["tracked_since"]}
        if not os.path.exists(usage_path(ctx)) and report["maintained"] is not None:
            warnings.append("no usage recorded for this machine yet ({})".format(short(usage_path(ctx))))
    if fetched is None or time.time() - fetched > 7 * 86400:
        warnings.append("last successful fetch: " + ago(fetched))
    try:
        with open(stamp("sync.log"), encoding="utf-8") as fh:
            tail = [ln.strip() for ln in fh.read().splitlines() if ln.strip()][-3:]
        warnings.extend("last sync: " + ln for ln in tail)
    except (OSError, UnicodeError):
        pass
    report["problems"], report["warnings"] = problems, warnings
    if args.json:
        say(json.dumps(report, indent=2, sort_keys=True, default=str))
        return 1 if problems else 0
    say("machine  {} ({})".format(ctx.machine or UNMATCHED,
                                 "skills profile" if ctx.has_profile else "default profile"))
    say("scope    {} · root {} · private {}".format(ctx.scope, short(ctx.root), "yes" if ctx.use_private else "no"))
    say("repos    " + (", ".join(short(r) for r in ctx.repos) or "(none)"))
    for label, state in sorted(report["checkouts"].items()):
        if state["exists"]:
            say("{:<8} {} on {} · {} dirty · ahead {} behind {}".format(
                label, short(state["path"]), state.get("branch"), state.get("dirty", 0),
                state.get("ahead", "?"), state.get("behind", "?")))
    shelved = sum(len(st.get("rarely_used", [])) for st in report["checkouts"].values())
    say("skills   {} selected of {} available · {} rarely used (not linked)".format(
        len(plan.selected), len(plan.available), shelved))
    if "usage" in report:
        say("usage    {} machine(s), tracked since {} · tidied {}".format(
            len(report["usage"]["machines"]), report["usage"]["tracked_since"] or "never",
            ago(report["maintained"])))
    for d, entry in sorted(report["links"].items()):
        say("links    {}: {} ok".format(short(d), entry["ok"]))
    for name in plan.overrides:
        say("note     private {} overrides public {}".format(name, name))
    say("fetch    " + ("fetched " + ago(fetched) if fetched else "never fetched"))
    for w in warnings:
        say("warning  " + w)
    for p in problems:
        say("problem  " + p)
    say("doctor: {}".format("{} problem(s)".format(len(problems)) if problems else "ok"))
    return 1 if problems else 0


# ----------------------------------------------------------------------------------------- guard

ALLOW_MARKER = "public-guard: allow"
GUARD_SKIP_DIRS = {".git", "node_modules", "__pycache__", ".venv", "venv", ".firecrawl",
                   ".skill-evals", ".evals", ".mypy_cache", ".pytest_cache"}
CODE_SUFFIXES = (".py", ".sh", ".bash", ".zsh", ".js", ".mjs", ".cjs", ".ts", ".tsx")
MAX_GUARD_BYTES = 2 * 1024 * 1024
HOME_PLACEHOLDERS = ("you|your-?name|user|username|me|name|example|runner|shared|Shared|USER|"
                     "ubuntu|vscode|node|linuxbrew|someone|alice|bob|Public|Default")
HOME_NAME = r"(?!(?:" + HOME_PLACEHOLDERS + r")(?![\w.-]))[A-Za-z0-9_][\w.-]*"
BUILTIN_PATTERNS = (
    ("home-path", re.compile(r"(?:(?<![\w.~-])|(?<=/mnt/[a-z]))/(?:Users|home)/" + HOME_NAME)),
    ("home-path", re.compile(r"\b[A-Za-z]:\\{1,2}Users\\{1,2}" + HOME_NAME)),
    ("sideproject-path", re.compile(r"(?:~|\$HOME|\$\{HOME\}|%USERPROFILE%)[/\\]Sideproject\b", re.I)),
    ("personal-email", re.compile(r"\b[A-Za-z0-9._%+-]+@(?:gmail|googlemail|hotmail|yahoo|outlook|"
                                  r"icloud|live|msn|protonmail|proton)\.[a-z]{2,}(?:\.[a-z]{2})?\b",
                                  re.I)),
    ("sg-nric", re.compile(r"\b[STFGM]\d{7}[A-Z]\b")),
    ("private-key", re.compile(r"-----BEGIN (?:[A-Z0-9]+ )*PRIVATE KEY-----")),
    ("token", re.compile(r"\b(?:gh[pousr]_[A-Za-z0-9]{36,}|github_pat_[A-Za-z0-9_]{40,}|"
                         r"sk-(?:ant-|proj-)?[A-Za-z0-9_-]{32,}|AKIA[0-9A-Z]{16}|"
                         r"xox[abprs]-[A-Za-z0-9-]{10,}|AIza[0-9A-Za-z_-]{35}|fc-[0-9a-f]{32}|"
                         r"glpat-[A-Za-z0-9_-]{20,})")),
    ("secret-assignment", re.compile(r"(?i)\b(?:api[_-]?key|secret|token|passw(?:or)?d)\b[\"']?\s*"
                                     r"[:=]\s*[\"'](?![$<{%])[^\"'\s]{16,}[\"']")),
)
PHONE_PATTERNS = (
    re.compile(r"(?<![\w+])\+\d{1,3}[ .-]?(?:\(\d{1,4}\)[ .-]?)?\d{2,4}(?:[ .-]?\d{2,4}){1,4}(?!\w)"),
    re.compile(r"(?<![\w+./:-])[689]\d{3}[ -]?\d{4}(?![\w/:-])"),
    re.compile(r"(?<![\w+./:-])(?:\(\d{3}\) ?|\d{3}[.-])\d{3}[.-]\d{4}(?![\w/-])"),
)
# Shelling out to another AI CLI from a skill starts a session outside the host's control (wrong
# config, model or account). Host-native subagents are fine; lines that only forbid a launch are fine.
AI_CLI_LAUNCH = (
    ("codex", re.compile(r"\bcodex\b.{0,40}\bexec\b", re.I)),
    ("claude", re.compile(r"\bclaude\b.{0,40}(?:-p|--print)\b", re.I)),
    ("gemini", re.compile(r"\bgemini\b.{0,40}(?:-p|--prompt)\b", re.I)),
    ("aider", re.compile(r"\baider\b.{0,40}--message\b", re.I)),
)
HARNESS_DECL = re.compile(r"\bharness:\s*(codex|claude)\b", re.I)
NON_LAUNCH_WORDS = re.compile(
    r"\b(?:never|not|forbid(?:s|den)?|reject(?:s|ed)?|must\s+not|do\s+not|don't|without|"
    r"instead\s+of|contamination|treat\s+any)\b", re.I)
PROCESS_CALLS = {
    "subprocess.run", "subprocess.Popen", "subprocess.call", "subprocess.check_call",
    "subprocess.check_output", "subprocess.getoutput", "subprocess.getstatusoutput",
    "os.system", "os.popen", "os.execv", "os.execvp", "os.execlp", "os.spawnvp", "pty.spawn",
    "asyncio.create_subprocess_exec", "asyncio.create_subprocess_shell",
}
LEGACY_STR = getattr(ast, "Str", None) if sys.version_info < (3, 8) else None


def phone_hit(line):
    for pattern in PHONE_PATTERNS:
        for m in pattern.finditer(line):
            digits = re.sub(r"\D", "", m.group(0))
            if 8 <= len(digits) <= 15 and not digits.endswith("0000") and len(set(digits)) > 2:
                return True
    return False


def ai_cli(text):
    for name, pattern in AI_CLI_LAUNCH:
        if pattern.search(text):
            return name
    return None


def strings_in(node):
    found = []
    for n in ast.walk(node):
        if isinstance(n, ast.Constant) and isinstance(getattr(n, "value", None), str):
            found.append((getattr(n, "lineno", 0), getattr(n, "col_offset", 0), n.value))
        elif LEGACY_STR is not None and isinstance(n, LEGACY_STR):
            found.append((getattr(n, "lineno", 0), getattr(n, "col_offset", 0), n.s))
    return " ".join(s for _, _, s in sorted(found, key=lambda t: (t[0], t[1])))


def call_name(node, aliases):
    if isinstance(node, ast.Name):
        return aliases.get(node.id, node.id)
    if isinstance(node, ast.Attribute):
        prefix = call_name(node.value, aliases)
        return (prefix + "." if prefix else "") + node.attr
    return ""


def line_launches(lines, prose):
    found = []
    for n, line in enumerate(lines, 1):
        cli = ai_cli(line)
        if not cli:
            continue
        context = (lines[n - 2] if n > 1 else "") + line
        comment = line.lstrip().startswith(("#", "//"))
        if (prose or comment) and NON_LAUNCH_WORDS.search(context):
            continue
        found.append((n, cli))
    return found


def python_launches(source):
    """(line, cli) for process calls whose command launches an AI CLI."""
    try:
        tree = ast.parse(source)
    except (SyntaxError, ValueError):
        return line_launches(source.splitlines(), prose=False)
    aliases = {}
    for node in ast.walk(tree):
        if isinstance(node, ast.Import):
            for a in node.names:
                aliases[a.asname or a.name] = a.name
        elif isinstance(node, ast.ImportFrom) and node.module in ("subprocess", "os", "asyncio", "pty"):
            for a in node.names:
                aliases[a.asname or a.name] = node.module + "." + a.name
    command_vars = {}
    for node in ast.walk(tree):
        value = getattr(node, "value", None) if isinstance(node, (ast.Assign, ast.AnnAssign)) else None
        if value is None:
            continue
        cli = ai_cli(strings_in(value))
        if cli:
            targets = node.targets if isinstance(node, ast.Assign) else [node.target]
            for t in targets:
                if isinstance(t, ast.Name):
                    command_vars[t.id] = cli
    found = []
    for node in ast.walk(tree):
        if not isinstance(node, ast.Call) or call_name(node.func, aliases) not in PROCESS_CALLS:
            continue
        parts = list(node.args) + [kw.value for kw in node.keywords if kw.arg in ("args", "cmd")]
        cli = ai_cli(" ".join(strings_in(p) for p in parts))
        if not cli:
            for p in parts:
                if isinstance(p, ast.Name) and p.id in command_vars:
                    cli = command_vars[p.id]
                    break
        if cli:
            found.append((node.lineno, cli))
    return found


def launch_findings(path, text, lines):
    name = os.path.basename(path)
    if name == "SKILL.md":
        return line_launches(lines, prose=True)
    shebang = lines[0] if lines and lines[0].startswith("#!") else ""
    if not name.endswith(CODE_SUFFIXES) and not shebang:
        return []
    if lines and "HISTORICAL_EVAL_LAUNCHER_DISABLED" in lines[0]:
        return []
    decl = HARNESS_DECL.search("\n".join(lines[:5]))
    harness = decl.group(1).lower() if decl else None
    if name.endswith(".py") or "python" in shebang:
        found = python_launches(text)
    else:
        found = line_launches(lines, prose=False)
    return [(n, cli) for n, cli in found if cli != harness]


def in_skill_folder(path):
    d = os.path.dirname(os.path.abspath(path))
    while True:
        if os.path.isfile(os.path.join(d, "SKILL.md")):
            return True
        if os.path.exists(os.path.join(d, ".git")):
            return False
        parent = os.path.dirname(d)
        if parent == d:
            return False
        d = parent


def metadata_exempt(path):
    """Repo metadata carries the public owner attribution; skill folders never are exempt."""
    name = os.path.basename(path)
    parent = os.path.basename(os.path.dirname(os.path.abspath(path)))
    if not (name.startswith(("LICENSE", "LICENCE")) or (parent == ".claude-plugin" and name.endswith(".json"))):
        return False
    return not in_skill_folder(path)


def load_terms(path):
    terms, bad = [], []
    if not path:
        return terms, bad
    try:
        with open(path, encoding="utf-8") as fh:
            lines = fh.read().splitlines()
    except (OSError, UnicodeError):
        return terms, bad
    for n, raw in enumerate(lines, 1):
        text = raw.strip()
        if not text or text.startswith("#"):
            continue
        try:
            terms.append(("guard-terms:{}".format(n), re.compile(text, re.I)))
        except re.error:
            bad.append(n)
    return terms, bad


def guard_files(paths):
    files, missing = [], []
    for p in paths:
        if os.path.isfile(p):
            files.append(p)
            continue
        if not os.path.isdir(p):
            missing.append(p)
            continue
        listed = git(p, "ls-files", "-co", "--exclude-standard", "-z")
        if listed is not None and listed.returncode == 0:
            for rel in sorted(x for x in listed.stdout.split("\0") if x):
                if not any(part in GUARD_SKIP_DIRS for part in rel.split("/")[:-1]):
                    files.append(os.path.join(p, rel))
            continue
        for dp, dns, fns in os.walk(p):
            dns[:] = sorted(d for d in dns if d not in GUARD_SKIP_DIRS)
            files.extend(os.path.join(dp, f) for f in sorted(fns))
    return files, missing


def scan_file(path, terms):
    try:
        if os.path.islink(path) or os.path.getsize(path) > MAX_GUARD_BYTES:
            return []
        with open(path, "rb") as fh:
            data = fh.read()
    except OSError:
        return []
    if b"\0" in data[:8192]:
        return []
    text = data.decode("utf-8", "replace")
    lines = text.splitlines()
    hits = []
    for n, line in enumerate(lines, 1):
        if ALLOW_MARKER in line:
            continue
        for name, pattern in BUILTIN_PATTERNS + tuple(terms):
            if pattern.search(line):
                hits.append((n, name))
        if phone_hit(line):
            hits.append((n, "phone"))
    for n, cli in launch_findings(path, text, lines):
        if not (0 < n <= len(lines) and ALLOW_MARKER in lines[n - 1]):
            hits.append((n, "ai-cli-launch:" + cli))
    return sorted(set(hits))


def guard_root(args_root=None):
    return expand(args_root or os.environ.get("SKILLS_ROOT") or DEFAULT_ROOT)


def run_guard(paths, root=None, terms_file=None):
    """(hits [(path, line, pattern)], missing paths, bad term line numbers)."""
    terms_path = expand(terms_file) if terms_file else os.path.join(guard_root(root), PRIVATE, "guard-terms.txt")
    terms, bad = load_terms(terms_path)
    files, missing = guard_files(paths)
    skip = os.path.realpath(terms_path)
    hits = []
    for path in files:
        if os.path.realpath(path) == skip or metadata_exempt(path):
            continue
        for n, name in scan_file(path, terms):
            hits.append((path, n, name))
    return hits, missing, bad, len(files)


def display(path):
    return os.path.normpath(path)


def report_guard(hits, missing, bad, scanned):
    for path, n, name in hits:
        say("{}:{}: {}".format(display(path), n, name))
    for p in missing:
        say("guard: no such path: " + p, sys.stderr)
    for n in bad:
        say("guard: guard-terms line {} is not a valid regex (skipped)".format(n), sys.stderr)
    if hits:
        say("guard: {} hit(s) in {} file(s); fix them or mark a deliberate line with `{}`".format(
            len(hits), len(set(h[0] for h in hits)), ALLOW_MARKER), sys.stderr)
    else:
        say("guard: clean ({} file(s))".format(scanned), sys.stderr)


def cmd_guard(args):
    hits, missing, bad, scanned = run_guard(args.paths or ["."], args.root, args.terms)
    report_guard(hits, missing, bad, scanned)
    if hits:
        return 2
    return 1 if missing else 0


# --------------------------------------------------------------------------------------- publish

def is_private_checkout(checkout):
    if os.path.basename(os.path.realpath(checkout)) == PRIVATE:
        return True
    url = git_out(checkout, "remote", "get-url", "origin") or ""
    return bool(re.search(r"skills-private(?:\.git)?/?$", url))


def find_linter(checkout):
    rel = os.path.join("skills", "skillsmith", "scripts", "lint_skill.py")
    candidates = [os.path.join(checkout, rel), os.path.join(os.path.dirname(checkout), PUBLIC, rel)]
    store = os.environ.get("HOST_REPO")
    if not store:
        r = run(["git", "rev-parse", "--show-toplevel"], timeout=5)
        store = r.stdout.strip() if r is not None and r.returncode == 0 else None
    if store:
        candidates.append(os.path.join(store, ".claude", "skills", "skillsmith", "scripts", "lint_skill.py"))
    for c in candidates:
        if os.path.isfile(c):
            return c
    return None


def changed_paths(checkout, upstream):
    paths = set()
    r = git(checkout, "status", "--porcelain", "-z", "--untracked-files=all")
    if r is not None and r.returncode == 0:
        items = r.stdout.split("\0")
        i = 0
        while i < len(items):
            item = items[i]
            if len(item) > 3:
                paths.add(item[3:])
                if item[0] in "RC":
                    i += 1  # rename source follows
            i += 1
    if upstream:
        diff = git_out(checkout, "diff", "--name-only", "@{u}...HEAD")
        paths.update(p for p in (diff or "").splitlines() if p)
    return paths


def changed_skills(checkout, paths):
    names = set()
    for p in paths:
        parts = p.split("/")
        if len(parts) >= 3 and parts[0] in TIERS:
            names.add(parts[1])
    return sorted(names)


def auto_message(checkout, paths):
    skills = changed_skills(checkout, paths)
    other = sorted(set(p.split("/")[0] for p in paths if p.split("/")[0] not in TIERS))
    named = skills + other
    head = ", ".join(named[:4]) + (" and {} more".format(len(named) - 4) if len(named) > 4 else "")
    return "Update {} (auto-sync)".format(head or "skills")


def save_checkout(checkout, message=None):
    """Guard (public), lint changed skills, commit, rebase if needed, push.
    Returns (status, lines). status: nothing | pushed | guard | lint | conflict | failed."""
    lines = []
    with file_lock(checkout_lock_path(checkout), blocking=True, timeout=120) as got:
        if not got:
            return "failed", ["another publish or sync holds the lock; try again"]
        branch = git_out(checkout, "symbolic-ref", "--quiet", "--short", "HEAD")
        if not branch:
            return "failed", ["detached HEAD; check out a branch first"]
        if any(os.path.exists(os.path.join(checkout, ".git", m))
               for m in ("MERGE_HEAD", "rebase-merge", "rebase-apply", "CHERRY_PICK_HEAD")):
            return "conflict", ["a merge or rebase is in progress; finish or abort it first"]
        upstream = git_out(checkout, "rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{u}")
        dirty = bool(git_out(checkout, "status", "--porcelain"))
        ahead = ahead_behind(checkout)[0] if upstream else 1
        if not dirty and not ahead:
            return "nothing", []
        paths = changed_paths(checkout, upstream)
        if not is_private_checkout(checkout):
            hits, _, bad, scanned = run_guard([checkout], root=os.path.dirname(checkout))
            if hits:
                for path, n, name in hits:
                    lines.append("{}:{}: {}".format(display(path), n, name))
                lines.append("guard hits in the public checkout; fix them (or mark a deliberate line "
                             "with `{}`)".format(ALLOW_MARKER))
                return "guard", lines
        skills = [s for s in changed_skills(checkout, paths)
                  if os.path.isfile(os.path.join(checkout, CORE, s, "SKILL.md"))]
        linter = find_linter(checkout)
        if skills and linter:
            failed = []
            for name in skills:
                r = run([sys.executable, linter, os.path.join(checkout, CORE, name)], timeout=120)
                if r is None or r.returncode != 0:
                    failed.append(name)
                    lines.append((r.stderr or r.stdout if r is not None else "lint timed out").rstrip())
            if failed:
                lines.append("lint failed: " + ", ".join(failed))
                return "lint", lines
        elif skills:
            lines.append("skillsmith linter not found; lint skipped")
        if dirty:
            for step in (["add", "-A"], ["commit", "--quiet", "-m", message or auto_message(checkout, paths)]):
                r = git(checkout, *step, timeout=120)
                if r is None or r.returncode != 0:
                    lines.append("git {} failed: {}".format(step[0], last_line(r)))
                    return "failed", lines
        push = ["push", "--quiet"] + ([] if upstream else ["-u", "origin", branch])
        r = git(checkout, *push, timeout=180)
        if (r is None or r.returncode != 0) and upstream:
            fetched = git(checkout, "fetch", "--quiet", "origin", timeout=120)
            if fetched is None or fetched.returncode != 0:
                lines.append("committed locally; push and fetch failed: " + last_line(fetched))
                return "failed", lines
            err = rebase_onto_upstream(checkout)
            if err:
                lines.append("committed locally, but the checkout " + err)
                return "conflict", lines
            r = git(checkout, *push, timeout=180)
        if r is None or r.returncode != 0:
            lines.append("committed locally, but the push failed: " + last_line(r))
            return "failed", lines
        lines.append("pushed {} {} ({})".format(short(checkout), git_out(checkout, "rev-parse", "--short", "HEAD"),
                                                git_out(checkout, "log", "-1", "--format=%s")))
        return "pushed", lines


def cmd_publish(args):
    checkout = git_out(expand(args.checkout), "rev-parse", "--show-toplevel")
    if not checkout:
        say("publish: not a git checkout: " + args.checkout, sys.stderr)
        return 1
    status, lines = save_checkout(checkout, args.message)
    for line in lines:
        say(("publish: " if status != "guard" or not re.search(r":\d+: ", line) else "") + line,
            sys.stdout if status in ("pushed", "guard") else sys.stderr)
    if status == "nothing":
        say("publish: nothing to publish")
    return {"nothing": 0, "pushed": 0, "guard": 2}.get(status, 1)


def cmd_autosync(args):
    """Stop hook: commit and push every dirty or unpushed checkout with a generated message.
    Exit 2 when something needs the agent (guard hit, lint failure, rebase conflict), 1 when a
    push failed for a transient reason, 0 otherwise. Prints nothing when nothing changed."""
    ctx = Context(args)
    code = 0
    for checkout in ctx.checkouts():
        if not os.path.isdir(os.path.join(checkout, ".git")):
            continue
        status, lines = save_checkout(checkout)
        label = "skills autosync ({}): ".format(short(checkout))
        out = sys.stdout if status == "pushed" else sys.stderr
        for line in lines:
            say(label + line, out)
        if status in ("guard", "lint", "conflict"):
            say(label + "not synced. If this is another session's unfinished edit, leave it; it syncs "
                "when that session stops.", sys.stderr)
            code = 2
        elif status == "failed" and code == 0:
            code = 1
    return code


# ------------------------------------------------------------------------------------------ find

FIND_STOP = set("a an and any are can could do does find for have help i if is it like me my of on "
                "one or see skill skills some something that the there this to we what which with you".split())
TIER_LABEL = {CORE: "core", SHELF: "rarely used", "retired": "retired", "external": "external"}
TIER_ORDER = {CORE: 0, SHELF: 1, "retired": 2, "external": 3}


def own_checkouts():
    """The checkout this tool runs from, and its private sibling when present."""
    public = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
    return public, os.path.join(os.path.dirname(public), PRIVATE)


def frontmatter(path):
    """(fields, body) of a SKILL.md: single-line values plus folded `>`/`|` blocks."""
    try:
        with open(path, encoding="utf-8") as fh:
            text = fh.read(MAX_GUARD_BYTES)
    except (OSError, UnicodeError):
        return {}, ""
    m = re.match(r"^---\s*\n(.*?)\n---\s*\n?(.*)$", text, re.S)
    if not m:
        return {}, text
    fields, key = {}, None
    for line in m.group(1).splitlines():
        kv = re.match(r"^([A-Za-z0-9_-]+):\s*(.*)$", line)
        if kv:
            key, value = kv.group(1), kv.group(2).strip()
            fields[key] = "" if value in (">", "|", ">-", "|-") else scalar(value) if value else ""
        elif key and line.startswith((" ", "\t")) and isinstance(fields.get(key), str):
            fields[key] = (fields[key] + " " + line.strip()).strip()
    return fields, m.group(2)


def find_entries(checkouts):
    entries = []
    for checkout in checkouts:
        if not os.path.isdir(checkout):
            continue
        kind = "private" if is_private_checkout(checkout) else "public"
        catalog = read_catalog(checkout)
        summaries = catalog.get("skill_summaries") if isinstance(catalog.get("skill_summaries"), dict) else {}
        category = {}
        for c in catalog.get("categories") or []:
            if not isinstance(c, dict):
                continue
            for n in c.get("skills") or []:
                category[n] = str(c.get("key") or "")
            for link in c.get("links") or []:
                if not isinstance(link, dict):
                    continue
                url = link.get("url") or ("https://github.com/" + link["repo"] if link.get("repo") else "")
                tags = link.get("tags") if isinstance(link.get("tags"), list) else []
                entries.append({
                    "name": str(link.get("name") or link.get("repo") or url), "tier": "external",
                    "kind": kind, "category": str(c.get("key") or ""), "where": url,
                    "description": str(link.get("note") or ""), "tags": [str(t) for t in tags],
                    "by": str(link.get("by") or ""), "source": str(link.get("from") or ""),
                    "source_url": str(link.get("from_url") or ""), "body": ""})
        folders = [(tier, scan(checkout, tier)) for tier in TIERS]
        folders.append(("retired", scan(os.path.join(checkout, "archive"), "skills")))
        for tier, found in folders:
            for name, folder in sorted(found.items()):
                fields, body = frontmatter(os.path.join(folder, "SKILL.md"))
                entries.append({
                    "name": name, "tier": tier, "kind": kind, "category": category.get(name, ""),
                    "where": os.path.join(folder, "SKILL.md"),
                    "description": str(fields.get("description") or summaries.get(name) or ""),
                    "summary": str(summaries.get(name) or ""), "tags": [], "source": "", "source_url": "",
                    "body": body})
    return entries


def query_terms(words):
    terms = []
    for w in re.findall(r"[a-z0-9]+", " ".join(words).lower()):
        if w not in FIND_STOP and len(w) > 1 and w not in terms:
            terms.append(w)
    return terms


def term_hits(term, text):
    text = text.lower().replace("-", " ")
    if len(term) >= 4:
        stem = term[:-1] if term.endswith("s") else term
        return stem in text
    return re.search(r"\b" + re.escape(term) + r"s?\b", text) is not None


def score_entry(entry, terms, phrase):
    fields = ((6, entry["name"]), (3, entry["description"] + " " + entry.get("summary", "")),
              (2, " ".join(entry["tags"]) + " " + entry["category"] + " " + entry.get("by", "") + " " + entry["source"]),
              (1, entry["body"]))
    total, matched = 0, 0
    for term in terms:
        best = max([w for w, text in fields if term_hits(term, text)] or [0])
        total += best
        matched += 1 if best else 0
    if not matched:
        return 0
    if matched == len(terms) and len(terms) > 1:
        total += 2
    if phrase and phrase.replace(" ", "-") in entry["name"].lower():
        total += 5
    return total


def cmd_find(args):
    if getattr(args, "machines", None):
        ctx = Context(args)
        checkouts = [ctx.public, ctx.private]
    else:
        checkouts = list(own_checkouts())
    entries = find_entries(checkouts)
    terms = query_terms(args.query)
    phrase = " ".join(args.query).strip().lower()
    if terms:
        ranked = [(score_entry(e, terms, phrase), e) for e in entries]
        ranked = [(sc, e) for sc, e in ranked if sc > 0]
    else:
        ranked = [(0, e) for e in entries]
    ranked.sort(key=lambda t: (-t[0], TIER_ORDER[t[1]["tier"]], t[1]["name"]))
    shown = ranked[:args.limit] if terms else ranked
    if args.json:
        say(json.dumps([dict({k: v for k, v in e.items() if k != "body"}, score=sc,
                             tier=TIER_LABEL[e["tier"]]) for sc, e in shown], indent=2))
        return 0 if shown else 1
    if not shown:
        say("find: nothing matches {!r} in {} skills and links; try other words".format(phrase, len(entries)))
        return 1
    if terms:
        say("{} of {} match(es) for {!r}:".format(len(shown), len(ranked), phrase))
    for sc, e in shown:
        where = short(e["where"]) if e["tier"] != "external" else e["where"]
        label = TIER_LABEL[e["tier"]] + ("" if e["tier"] == "external" else ", " + e["kind"])
        say("")
        say("{}{}  [{}{}]".format(e["name"], " by " + e["by"] if e.get("by") else "", label,
                                  ", " + e["category"] if e["category"] else ""))
        if e["description"]:
            desc = " ".join(e["description"].split())
            say("  " + (desc if len(desc) <= 240 else desc[:237] + "..."))
        say("  " + where)
        if e["source"]:
            say("  seen in: {}{}".format(e["source"], " (" + e["source_url"] + ")" if e["source_url"] else ""))
    if any(e["tier"] == SHELF for _, e in shown):
        say("")
        say("rarely used = not linked. Read its SKILL.md in place and follow it; a use moves it back to core "
            "at the next daily tidy, or run `skills restore NAME` to link it now.")
    return 0


# ------------------------------------------------------------------------------- usage commands

def usage_report(ctx):
    tidy = Tidy(ctx)
    rows = {}
    for (checkout, name), (tier, _) in sorted(tidy.entries.items(), key=lambda t: t[0][1]):
        days = tidy.usage["skills"].get(name, [])
        tier = tidy.tier(name)
        verdict = "shelve" if name in tidy.shelve else "restore" if name in tidy.restore else \
            ("keep" if tier == CORE else "stay shelved")
        kind = "private" if checkout == ctx.private else "public"
        if name in rows:
            kind = rows[name]["kind"] + "+" + kind
        rows[name] = {"tier": TIER_LABEL[tier], "kind": kind, "last": days[-1] if days else None,
                      "days_used": len(days), "tier_since": tidy.since[name], "verdict": verdict,
                      "reason": tidy.reason.get(name, "")}
    return {"machines": tidy.usage["machines"], "tracked_since": tidy.usage["tracked_since"],
            "idle_days": IDLE_DAYS, "window_days": USAGE_DAYS, "skills": rows}


def cmd_usage(args):
    ctx = Context(args)
    if args.scan:
        if ctx.use_private and os.path.isdir(ctx.private):
            record_usage(ctx)
        else:
            say("usage: no private checkout on this machine, so usage can't be recorded", sys.stderr)
    report = usage_report(ctx)
    if args.json:
        say(json.dumps(report, indent=2, sort_keys=True))
        return 0
    say("usage from {} machine(s) ({}), tracked since {}; idle after {} days".format(
        len(report["machines"]), ", ".join(report["machines"]) or "none", report["tracked_since"] or "never",
        IDLE_DAYS))
    say("{:<22} {:<12} {:<8} {:<11} {:>4}  {:<12} {}".format("skill", "tier", "kind", "last used", "days",
                                                            "verdict", "why"))
    for name, r in sorted(report["skills"].items(), key=lambda t: (t[1]["tier"], t[0])):
        say("{:<22} {:<12} {:<8} {:<11} {:>4}  {:<12} {}".format(
            name, r["tier"], r["kind"], r["last"] or "-", r["days_used"], r["verdict"], r["reason"]))
    return 0


def cmd_tidy(args):
    ctx = Context(args)
    if not (ctx.use_private and os.path.isdir(ctx.private)):
        say("tidy: usage lives in the private checkout, which this machine's profile doesn't have", sys.stderr)
        return 1
    tidy = Tidy(ctx)
    if not tidy.shelve and not tidy.restore:
        say("tidy: nothing to move" + ("" if tidy.enough_data else " (under {} days of usage data)".format(IDLE_DAYS)))
        return 0
    for name in sorted(tidy.shelve):
        say("shelve   {:<22} {}".format(name, tidy.reason.get(name, "")))
    for name in sorted(tidy.restore):
        say("restore  {:<22} {}".format(name, tidy.reason.get(name, "")))
    if args.dry_run:
        return 0
    return apply_moves(ctx.checkouts(), tidy.moves)


def apply_moves(checkouts, moves, message=None):
    code = 0
    for checkout in checkouts:
        shelve, restore = moves(checkout)
        if not shelve and not restore:
            continue
        ok, err = move_skills(checkout, shelve, restore, message(checkout) if callable(message) else message)
        if not ok:
            say("{}: {}".format(short(checkout), err), sys.stderr)
            code = 1
            continue
        status, lines = save_checkout(checkout)
        for line in lines:
            say(line, sys.stdout if status in ("pushed", "nothing") else sys.stderr)
        if status not in ("pushed", "nothing"):
            code = 1
    return code


def cmd_move(args):
    """skills shelve|restore NAME ...: move by hand. A restore arrives in core today, so it stays a
    month; tidy brings back a shelved skill that was used in the last month."""
    if getattr(args, "machines", None):
        ctx = Context(args)
        checkouts = [c for c in ctx.checkouts() if os.path.isdir(c)]
    else:
        checkouts = [c for c in own_checkouts() if os.path.isdir(c)]
    src = CORE if args.command == "shelve" else SHELF
    where, missing = {}, []
    for name in args.names:
        hits = [c for c in checkouts if name in scan(c, src)]
        if hits:
            where.setdefault(hits[-1], []).append(name)
        else:
            missing.append(name)
    for name in missing:
        say("{}: no {} skill named {}".format(args.command, TIER_LABEL[src], name), sys.stderr)
    if not where:
        return 1
    verb = "Shelve" if args.command == "shelve" else "Restore"
    moves = lambda c: (where.get(c, []), []) if args.command == "shelve" else ([], where.get(c, []))  # noqa: E731
    code = apply_moves(list(where), moves, lambda c: "{} {} (by hand)".format(verb, ", ".join(where.get(c, []))))
    return code or (1 if missing else 0)


# ------------------------------------------------------------------------------------------ main

def add_profile_args(p):
    p.add_argument("--repo", action="append", metavar="R",
                   help="repo to link into (repeatable; profile repos are added)")
    p.add_argument("--machines", metavar="M", help="machines registry JSON (e.g. machines.json)")


def build_parser():
    parser = argparse.ArgumentParser(prog="skills", description=__doc__.split("\n\n")[0],
                                     formatter_class=argparse.RawDescriptionHelpFormatter,
                                     epilog=__doc__.split("\n\n", 1)[1])
    sub = parser.add_subparsers(dest="command", metavar="COMMAND")
    up = sub.add_parser("up", help="sync in the background, link, register MCP, print one status line")
    add_profile_args(up)
    up.add_argument("--hook", choices=("claude", "codex"), help="format output for a SessionStart hook")
    up.add_argument("--wait", action="store_true", help="clone/fetch in the foreground first")
    link = sub.add_parser("link", help="create the enabled links and remove stale ones")
    add_profile_args(link)
    unlink = sub.add_parser("unlink", help="remove every link into the checkouts")
    add_profile_args(unlink)
    doctor = sub.add_parser("doctor", help="report profile, links, checkouts, fetch; exit 1 on problems")
    add_profile_args(doctor)
    doctor.add_argument("--json", action="store_true")
    guard = sub.add_parser("guard", help="public-safety scan; exit 2 on hits")
    guard.add_argument("paths", nargs="*", metavar="PATH")
    guard.add_argument("--root", help="checkouts root (default: $SKILLS_ROOT or the default root)")
    guard.add_argument("--terms", help="extra guard terms file (default: <root>/skills-private/guard-terms.txt)")
    publish = sub.add_parser("publish", help="lock, guard (public), lint, commit, push")
    publish.add_argument("--checkout", required=True, metavar="C")
    publish.add_argument("-m", "--message", required=True, metavar="MSG")
    autosync = sub.add_parser("autosync", help="Stop hook: publish every dirty or unpushed checkout "
                                                "with a generated message; exit 2 when the agent must fix something")
    add_profile_args(autosync)
    find = sub.add_parser("find", help="search core, rarely used and retired skills plus external links")
    find.add_argument("query", nargs="*", metavar="QUERY")
    find.add_argument("--json", action="store_true")
    find.add_argument("--limit", type=int, default=8, metavar="N")
    find.add_argument("--machines", metavar="M", help="use this machine's checkouts (default: beside this tool)")
    find.add_argument("--repo", action="append", metavar="R", help=argparse.SUPPRESS)
    usage = sub.add_parser("usage", help="per-skill last use across machines and what tidy would do")
    add_profile_args(usage)
    usage.add_argument("--scan", action="store_true", help="record this machine's transcripts first")
    usage.add_argument("--json", action="store_true")
    tidy = sub.add_parser("tidy", help="shelve idle core skills and restore used shelved ones, then push")
    add_profile_args(tidy)
    tidy.add_argument("--dry-run", action="store_true")
    for verb, text in (("shelve", "move core skills to rarely-used/ and push"),
                       ("restore", "move rarely used skills back to core and push")):
        move = sub.add_parser(verb, help=text)
        move.add_argument("names", nargs="+", metavar="NAME")
        add_profile_args(move)
    sync = sub.add_parser("_sync")
    add_profile_args(sync)
    return parser


def main(argv=None):
    try:
        sys.stdout.reconfigure(errors="replace")
    except (AttributeError, ValueError):
        pass
    parser = build_parser()
    args = parser.parse_args(argv)
    handlers = {"up": cmd_up, "link": cmd_link, "unlink": cmd_unlink, "doctor": cmd_doctor,
                "guard": cmd_guard, "publish": cmd_publish, "autosync": cmd_autosync, "find": cmd_find,
                "usage": cmd_usage, "tidy": cmd_tidy, "shelve": cmd_move, "restore": cmd_move,
                "_sync": lambda a: (sync_checkouts(Context(a)), 0)[1]}
    if args.command not in handlers:
        parser.print_help()
        return 1
    return handlers[args.command](args)


if __name__ == "__main__":
    sys.exit(main())
